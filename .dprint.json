{
  "lineWidth": 100,
  "indentWidth": 2,
  "newLineKind": "lf",
  "markdown": {
    "textWrap": "maintain"
  },
  "excludes": [
    "**/Artifacts/**",
    "**/ThirdParty/**",
    "**/vendor/**",
    "**/fixtures/**",
    "**/target/**",
    "**/.build/**",
    "**/.native-build/**",
    "**/bin/**",
    "**/obj/**",
    "**/build/**",
    "**/DerivedData/**",
    "**/CHANGELOG*",
    "**/HISTORY*"
  ],
  "plugins": [
    "npm:@dprint/json@0.26.0",
    "npm:@dprint/markdown@0.29.0",
    "npm:@dprint/toml@0.10.0",
    "npm:dprint-plugin-yaml@0.6.0"
  ]
}
